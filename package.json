{
  "name": "knockbound",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Knockbound browser party game",
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "node tools/dev-server.mjs",
    "dev:online": "node tools/dev-server.mjs 4179 --multiplayer",
    "preview": "node tools/dev-server.mjs 4178 --dist",
    "test": "node --test tests/simulation.test.ts tests/server.test.mjs tests/authority.test.ts tests/transport.test.ts tests/network-client.test.ts tests/network-latency.test.ts tests/worker-contract.test.ts tests/audio.test.ts tests/effects.test.ts tests/touch.test.ts tests/context-recovery.test.ts tests/camera.test.ts tests/items.test.ts tests/ranged.test.ts tests/tiles.test.ts tests/crates.test.ts tests/hazards.test.ts tests/pods.test.ts tests/characters.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "node tools/build.mjs",
    "check:bootstrap": "node tools/validate-bootstrap.mjs",
    "dev:worker": "node tools/worker-local.mjs",
    "check:worker": "node tools/worker-local.mjs --check",
    "test:worker": "node --test tests/worker.test.ts",
    "build:audio": "node tools/build-audio.mjs",
    "preview:audio": "node tools/audio-preview.mjs",
    "dev:qa": "node tools/dev-server.mjs 4181 --qa",
    "dev:phone": "node tools/dev-server.mjs 4183 --lan"
  },
  "dependencies": {
    "three": "0.180.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/three": "0.180.0",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "wrangler": "4.129.1"
  }
}
