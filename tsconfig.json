{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true
  },
  "include": [
    "shared/**/*.ts",
    "client/**/*.ts",
    "server/**/*.ts",
    "tests/**/*.ts",
    "tools/visual-qa.ts",
    "tools/context-qa.ts"
  ]
}
